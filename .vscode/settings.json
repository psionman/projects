{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.ruff": "explicit",
    "source.organizeImports.ruff": "explicit",
  },
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#848ae6",
    "titleBar.activeForeground": "#000000",
    "titleBar.inactiveBackground": "#aeb2ef",
    "breadcrumb.foreground": "#33d033",
    "activityBar.activeBackground": "#848ae6",
    "activityBar.background": "#aeb2ef",
    "activityBar.foreground": "#000000",
    "activityBarBadge.background": "#da454e",
    "activityBarBadge.foreground": "#e7e7e7",
    "statusBar.background": "#848ae6",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#ff62dd",
  },
}